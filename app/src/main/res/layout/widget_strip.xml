<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/w_bg"
    android:paddingStart="14dp" android:paddingEnd="14dp">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Clear for" android:textSize="10sp" android:textColor="@color/w_muted" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/w_days" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginEnd="4dp" android:text="3d" android:textSize="18sp" android:fontFamily="serif" android:textColor="@color/w_ink" />
            <Chronometer android:id="@+id/w_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="18sp" android:fontFamily="serif" android:textColor="@color/w_ink" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:layout_width="1dp" android:layout_height="32dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
        android:background="@color/w_divider" android:contentDescription="@null" />
    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_gull"
        android:tint="@color/w_teal" android:contentDescription="Gulls set free" />
    <TextView android:id="@+id/w_gulls" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="4dp" android:text="5" android:textSize="14sp" android:textColor="@color/w_ink" />
    <ImageView android:layout_width="1dp" android:layout_height="32dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
        android:background="@color/w_divider" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_t_bulb"
                android:tint="@color/w_muted" android:contentDescription="@null" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp"
                android:text="Heads up" android:textSize="10sp" android:textColor="@color/w_muted" />
        </LinearLayout>
        <TextView android:id="@+id/w_next" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:singleLine="true" android:ellipsize="end" android:text="After dinner around 19:45" android:textSize="12sp" android:textColor="@color/w_ink" />
    </LinearLayout>
</LinearLayout>
