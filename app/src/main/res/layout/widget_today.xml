<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/w_bg"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Today · day 4" android:textSize="11sp" android:textColor="@color/w_muted" />
            <TextView android:id="@+id/w_done" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="3 of 7 done" android:textSize="20sp" android:fontFamily="serif" android:textColor="@color/w_ink" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Clear for" android:textSize="11sp" android:textColor="@color/w_muted" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/w_days" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="3dp" android:text="3d" android:textSize="13sp" android:textColor="@color/w_ink" />
                <Chronometer android:id="@+id/w_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textColor="@color/w_ink" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/w_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp"
        android:max="100" android:progress="43" android:progressDrawable="@drawable/w_progress" />

    <LinearLayout android:id="@+id/w_row1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/w_row_other" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp">
        <ImageView android:id="@+id/w_row1_icon" android:layout_width="16dp" android:layout_height="16dp"
            android:src="@drawable/ic_t_circle_dot" android:contentDescription="@null" />
        <TextView android:id="@+id/w_row1_time" android:layout_width="42dp" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="12:45" android:textSize="11sp" android:textColor="@color/kind_other_fg" />
        <TextView android:id="@+id/w_row1_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:singleLine="true" android:ellipsize="end" android:text="Routine item" android:textSize="13sp" android:textColor="@color/kind_other_fg" />
        <ImageView android:id="@+id/w_row1_check" android:layout_width="28dp" android:layout_height="28dp" android:padding="4dp"
            android:src="@drawable/ic_ring" android:contentDescription="Mark done" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_row2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/w_row_other" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp">
        <ImageView android:id="@+id/w_row2_icon" android:layout_width="16dp" android:layout_height="16dp"
            android:src="@drawable/ic_t_circle_dot" android:contentDescription="@null" />
        <TextView android:id="@+id/w_row2_time" android:layout_width="42dp" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="12:45" android:textSize="11sp" android:textColor="@color/kind_other_fg" />
        <TextView android:id="@+id/w_row2_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:singleLine="true" android:ellipsize="end" android:text="Routine item" android:textSize="13sp" android:textColor="@color/kind_other_fg" />
        <ImageView android:id="@+id/w_row2_check" android:layout_width="28dp" android:layout_height="28dp" android:padding="4dp"
            android:src="@drawable/ic_ring" android:contentDescription="Mark done" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_row3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/w_row_other" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp">
        <ImageView android:id="@+id/w_row3_icon" android:layout_width="16dp" android:layout_height="16dp"
            android:src="@drawable/ic_t_circle_dot" android:contentDescription="@null" />
        <TextView android:id="@+id/w_row3_time" android:layout_width="42dp" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="12:45" android:textSize="11sp" android:textColor="@color/kind_other_fg" />
        <TextView android:id="@+id/w_row3_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:singleLine="true" android:ellipsize="end" android:text="Routine item" android:textSize="13sp" android:textColor="@color/kind_other_fg" />
        <ImageView android:id="@+id/w_row3_check" android:layout_width="28dp" android:layout_height="28dp" android:padding="4dp"
            android:src="@drawable/ic_ring" android:contentDescription="Mark done" />
    </LinearLayout>
    <TextView android:id="@+id/w_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:visibility="gone" android:text="Open Dusk to build your routine." android:textSize="12sp" android:textColor="@color/w_muted" />
    <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_t_bulb"
            android:tint="@color/w_muted" android:contentDescription="@null" />
        <TextView android:id="@+id/w_next" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="4dp" android:singleLine="true" android:ellipsize="end"
            android:text="After dinner around 19:45" android:textSize="11sp" android:textColor="@color/w_muted" />
        <TextView android:id="@+id/w_pill" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:background="@drawable/w_pill"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp"
            android:text="Ride it out" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:textColor="@color/w_on_coral" />
    </LinearLayout>
</LinearLayout>
