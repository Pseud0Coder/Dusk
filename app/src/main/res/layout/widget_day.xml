<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_bg" android:clipToOutline="true">
    <ImageView android:id="@+id/w_scene" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:src="@drawable/w_scene_preview" android:contentDescription="@null" />
    <TextView android:id="@+id/w_day" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:gravity="center_horizontal" android:text="4"
        android:textSize="30sp" android:fontFamily="serif" android:textColor="@color/w_ink" />
</FrameLayout>
